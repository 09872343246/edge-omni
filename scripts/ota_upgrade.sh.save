#!/bin/bash

set -euo pipefail




APP_DIR="/app"
CURRENT_LINK="${APP_DIR}/current"
V1_DIR="${APP_DIR}/v1"
V2_DIR="${APP_DIR}/v2"
TMP_DIR="/tmp/ota_$$"
SERVICE_NAME="edge-omni"
WATCHDOG_DEV="/dev/watchdog"
SUCCESS_MAGIC="OTA_OK"
ROLLBACK_TIMEOUT=10



RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'



log_info()  { echo -e "${GREEN}[INFO]${NC}  $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC}  $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*"; }



if [ "$#" -ne 2 ]; then
    log_error "用法: $0 <tarball_url> <md5_url>"
    exit 1
fi




TARBALL_URL="$1"
MD5_URL="$2"
TARBALL_FILE="${TMP_DIR}/v2.tar.gz"
MD5_FILE="${TMP_DIR}/v2.tar.gz.md5"

mkdir -p "${TMP_DIR}


log_info "正在下载新版本..."
wget -q --show-progress "${TARBALL_URL}" -O "${TARBALL_FILE}"


log_info "正在下载 MD5 校验文件..."
wget -q "${MD5_URL}" -O "${MD5_FILE}"

log_info "校验 MD5..."
cd "${TMP_DIR}"
if ! md5sum -c "${MD5_FILE}"; then
    log_error "MD5 校验失败！文件可能损坏或被篡改。"
    rm -rf "${TMP_DIR}"
    exit 1
fi
log_info "MD5 校验通过 ✓"



log_info "清理旧 v2 目录..."
rm -rf "${V2_DIR}"/*
mkdir -p "${V2_DIR}"

log_info "解压到 ${V2_DIR}..."
tar -xzf "${TARBALL_FILE}" -C "${V2_DIR}" --strip-components=1



log_info "停止 ${SERVICE_NAME} 服务..."
systemctl stop "${SERVICE_NAME}"




log_info "切换软链接: ${CURRENT_LINK} -> ${V2_DIR}"
ln -sfn "${V2_DIR}" "${CURRENT_LINK}"




if [ "$(readlink -f "${CURRENT_LINK}")" != "${V2_DIR}" ]; then
    log_error "软链接切换失败！"
    ln -sfn "${V1_DIR}" "${CURRENT_LINK}"
    systemctl start "${SERVICE_NAME}"
    exit 1
fi
log_info "软链接切换成功 ✓"



log_info "启动 ${SERVICE_NAME} 服务 (v2)..."
systemctl start "${SERVICE_NAME}"



log_info "等待服务启动成功标志（超时 ${ROLLBACK_TIMEOUT} 秒）..."

START_TIME=$(date +%s)
ROLLBACK_NEEDED=0

while true; do
	CURRENT_TIME=$(date +%s)
	ELAPSED=$((CURRENT_TIME - START_TIME))

	if [ "${ELAPSED}" -ge "${ROLLBACK_TIMEOUT}" ]; then
		log_warn "超时未收到启动成功标志！"
		ROLLBACK_NEEDED=1
		break
	fi
	if [ -f "/tmp/ota_success_flag" ]; then
		FLAG=$(cat /tmp/ota_success_flag)
		if [ "${FLAG}" = "${SUCCESS_MAGIC}" ]; then
			log_info "收到启动成功标志 ✓"
			ROLLBACK_NEEDED=0
			break1~break
		fi
	fi


	sleep 1
done


if [ "${ROLLBACK_NEEDED}" -eq 1 ]; then
	log_error "v2 启动验证失败，执行回滚..."
	log_info "停止 v2 服务..."
	systemctl stop "${SERVICE_NAME}"
	log_info "回滚软链接到 v1..."
	

